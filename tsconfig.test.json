{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@deployment": ["./deployments/testnet.json"],
      "@client/*": ["./client/src/*"],
      "@test/*": ["./test/*"],
      "@testnet/*": ["./server/scripts/testnet/*"],
      "@schema/*": ["./packages/schema/src/*"],
      "@kanso/schema": ["./packages/schema/src/index.ts"],
      "@bindings/*": ["./packages/bindings/src/*"],
      "@sdk/*": ["./packages/sdk/src/*"],
      "@server/*": ["./server/src/*"],
      "@kanso/bindings": ["./packages/bindings/src/index.ts"],
      "@kanso/sdk": ["./packages/sdk/src/index.ts"],
      "@kanso/server": ["./server/src/index.ts"]
    },
    "types": ["node"],
    "declaration": false
  },
  "include": ["test", "vitest.config.ts", "server/test"]
}
