{
  "name": "kanso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "build:coordinator": "cargo near build non-reproducible-wasm --manifest-path contracts/near/Cargo.toml --locked --no-abi --out-dir contracts/near/target/near",
    "build:test-token": "cargo near build non-reproducible-wasm --manifest-path contracts/near/tests/settlement-token/Cargo.toml --locked --no-abi --out-dir contracts/near/target/near",
    "build:near": "pnpm build:coordinator",
    "test:near": "cargo test --locked --manifest-path contracts/near/Cargo.toml",
    "check:near": "cargo fmt --manifest-path contracts/near/Cargo.toml --check && cargo clippy --locked --manifest-path contracts/near/Cargo.toml --all-targets -- -D warnings",
    "setup:evm": "forge install foundry-rs/forge-std@v1.12.0 --no-git --root contracts/evm",
    "build:evm": "forge build --root contracts/evm",
    "test:evm": "forge test --root contracts/evm"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@kanso/schema": "workspace:*",
    "@types/node": "26.6.5",
    "cargo-near": "0.22.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
