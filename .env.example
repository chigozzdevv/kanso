NODE_ENV=development
HOST=127.0.0.1
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/kanso?replicaSet=kanso-rs
REDIS_URL=redis://127.0.0.1:6379
DEPLOYMENT_FILE=../deployments/testnet.json
AUTH_DOMAIN=localhost
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3054,http://127.0.0.1:3054
NEXT_PUBLIC_KANSO_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_KANSO_AUTH_DOMAIN=localhost
LOG_LEVEL=info
WORKER_CONCURRENCY=4
WORKER_TICK_MS=3000
MPC_DEPOSIT_ATOMIC=1
SOLVER_FEE_BPS=0
SOLVER_RECIPIENTS={}

# Optional funded accounts. Configure each account and key together.
RELAYER_ACCOUNT=
RELAYER_PRIVATE_KEY=
SOLVER_ACCOUNT=
SOLVER_PRIVATE_KEY=

# Server-only RPC overrides. Use the testnet API key for these networks.
# TATUM_API_KEY=
# BASE_RPC_URL=https://base-sepolia.gateway.tatum.io
# BITCOIN_RPC_URL=https://bitcoin-testnet.gateway.tatum.io
